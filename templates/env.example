# Copy to .env and fill in. NEVER commit .env — it is gitignored by init.mjs.
# walkthrough.config.mjs holds no secrets; everything sensitive lives here.

# ── the app under test ───────────────────────────────────────────────────────
# Use a project-specific name if you keep several projects side by side, and
# make the config read that exact name. A recorder that falls back to another
# project's URL records the wrong product, and it is easy not to notice.
APP_URL=

# Optional. With these the recorder can sign itself in, including mid-run when a
# session expires. Without them, `record.mjs --login` opens a window and waits.
APP_EMAIL=
APP_PASSWORD=

# ── voice-over ───────────────────────────────────────────────────────────────
# Google Cloud Text-to-Speech: the narration voice.
CLOUDTTS_API_KEY=
CLOUDTTS_VOICE=en-US-Chirp3-HD-Achird
# CLOUDTTS_RATE=0.95

# Required. Word-level transcription, used twice: to recover per-sentence cue
# timings from the generated audio, and by verify-sync.mjs to prove the finished
# video's picture matches its narration.
OPENAI_API_KEY=

# ── binaries (only if not on PATH) ───────────────────────────────────────────
# FFMPEG=ffmpeg
# FFPROBE=ffprobe

# ── capture / encode overrides ───────────────────────────────────────────────
# CAPTURE=dda        dda | cdp
# CAP_FPS=30
# HWENC=nvenc        nvenc | qsv | (unset = CPU libx264)
